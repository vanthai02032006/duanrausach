# Development only. Generate your own SECRET_KEY for real deployment.
SECRET_KEY=change-this-to-a-long-random-secret
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Docker Compose uses service hostname db. For local PostgreSQL use localhost.
DATABASE_URL=postgresql://greenfarm_user:greenfarm_demo_password@db:5432/greenfarm_db

# Get a key from Google AI Studio. Never put this key in frontend JavaScript or commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_SECONDS=25
